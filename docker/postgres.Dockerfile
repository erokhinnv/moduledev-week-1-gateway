# Авторитетное состояние. Собственный образ нужен ровно за тем, чтобы скрипт создания ролей
# попал внутрь образа на этапе сборки, а не подключался bind mount'ом с хоста: контур проверки
# запрещает любые bind mounts, и это правильное ограничение — стек обязан быть самодостаточным.
FROM postgres:17-alpine

# Официальный entrypoint образа выполняет содержимое этого каталога РОВНО ОДИН РАЗ, и только при
# инициализации пустого тома данных. На уже инициализированном томе скрипт не запускается вообще.
COPY db/init/ /docker-entrypoint-initdb.d/
