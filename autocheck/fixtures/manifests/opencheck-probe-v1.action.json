{
  "contract_version": "course-1",
  "module": "opencheck",
  "action": "probe",
  "version": 1,
  "http_method": "POST",
  "target_schema": "opencheck",
  "target_function": "probe_v1",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["mode", "value"],
    "properties": {
      "mode": {
        "enum": ["ok", "error", "unknown_outcome", "invalid_result"]
      },
      "value": {"type": "string", "minLength": 1, "maxLength": 128}
    }
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["stored", "revision", "principal"],
    "properties": {
      "stored": {"type": "boolean"},
      "revision": {"const": 1},
      "principal": {"type": "string"}
    }
  },
  "outcomes": ["APPLIED"],
  "required_policy": ["workflow:execute"],
  "idempotency_mode": "required",
  "idempotency_scope": "principal_action",
  "timeout_ms": 2000,
  "enabled": true,
  "is_default": true
}
