{
  "contract_version": "course-1",
  "module": "payment",
  "action": "prepare_external",
  "version": 1,
  "http_method": "POST",
  "target_schema": "payment",
  "target_function": "prepare_external_v1",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "operationId"
    ],
    "properties": {
      "operationId": {
        "type": "string",
        "format": "uuid"
      }
    }
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "operationId",
      "externalRequestId"
    ],
    "properties": {
      "operationId": {
        "type": "string",
        "format": "uuid"
      },
      "externalRequestId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "not": {
          "pattern": "[\\r\\n]"
        }
      }
    }
  },
  "outcomes": [
    "PREPARED"
  ],
  "required_policy": [
    "payment:internal"
  ],
  "idempotency_mode": "required",
  "idempotency_scope": "principal_action",
  "timeout_ms": 5000,
  "enabled": true,
  "is_default": true
}
